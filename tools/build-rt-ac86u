#!/usr/bin/env bash
set -euo pipefail

root=$(git rev-parse --show-toplevel)
revision=$(git rev-parse --verify "${1:-HEAD}^{commit}")
image=gnuton/asuswrt-merlin-toolchains-docker@sha256:8c9681987352d6eb8a38708126c9c39edd8dd28a7bf6c0cedc0e9534387f9ab3
jobs=${BUILD_JOBS:-12}
[[ $jobs =~ ^[1-9][0-9]*$ ]] || { echo 'BUILD_JOBS must be a positive integer' >&2; exit 1; }
output="$root/artifacts/$revision"
mkdir -p "$output"

docker run --rm --platform linux/amd64 --user root \
  --env SOURCE_REVISION="$revision" \
  --env BUILD_JOBS="$jobs" \
  --env OUTPUT_UID="$(id -u)" --env OUTPUT_GID="$(id -g)" \
  --mount "type=bind,source=$root,destination=/project,readonly" \
  --mount "type=volume,source=asuswrt-ac86u-$revision,destination=/build" \
  --mount "type=bind,source=$output,destination=/artifacts" \
  "$image" bash -lc '
    set -euo pipefail
    if test -d /build/source/.git && test "$(stat -c %U /build/source/.git)" != docker; then
      chown -R docker:docker /build/source
    fi
    install -d -o docker -g docker /build/source
    mkdir -p /build/source/.git
    rsync -a /project/.git/ /build/source/.git/
    chown -R docker:docker /build/source/.git
    cd /build/source
    gosu docker git config extensions.worktreeConfig false
    gosu docker git config core.ignorecase false
    gosu docker git reset --hard "$SOURCE_REVISION"
    gosu docker git clean -ffdqx
    gosu docker git sparse-checkout init --cone
    gosu docker git sparse-checkout set tools release/src release/src-rt release/src-rt-5.02hnd
    gosu docker git checkout --detach "$SOURCE_REVISION"
    set +u
    source /home/docker/envs/bcm-hnd.sh
    set -u
    gosu docker make -C release/src-rt-5.02hnd rt-ac86u PARALLEL_BUILD="-j$BUILD_JOBS" BRCM_MAX_JOBS="$BUILD_JOBS"
    if test -x tools/check-ac86u-rootfs; then
      bash tools/check-ac86u-rootfs /build/source
    fi
    images=(release/src-rt-5.02hnd/image/RT-AC86U_*_ubi.w)
    test -f "${images[0]}"
    cp "${images[@]}" /artifacts/
    printf "%s\n" "$SOURCE_REVISION" > /artifacts/source-commit.txt
    cd /artifacts
    sha256sum RT-AC86U_*_ubi.w > SHA256SUMS
    chown "$OUTPUT_UID:$OUTPUT_GID" RT-AC86U_*_ubi.w source-commit.txt SHA256SUMS
  '
