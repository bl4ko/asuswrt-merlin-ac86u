#!/usr/bin/env bash
set -euo pipefail

root=$(git rev-parse --show-toplevel)
revision=$(git rev-parse --verify "${1:-HEAD}^{commit}")
image=gnuton/asuswrt-merlin-toolchains-docker@sha256:8c9681987352d6eb8a38708126c9c39edd8dd28a7bf6c0cedc0e9534387f9ab3
output="$root/artifacts/$revision"
mkdir -p "$output"

docker run --rm --platform linux/amd64 --user root \
  --env SOURCE_REVISION="$revision" \
  --env OUTPUT_UID="$(id -u)" --env OUTPUT_GID="$(id -g)" \
  --mount "type=bind,source=$root,destination=/project,readonly" \
  --mount "type=volume,source=asuswrt-ac86u-$revision,destination=/build" \
  --mount "type=bind,source=$output,destination=/artifacts" \
  "$image" bash -lc '
    set -euo pipefail
    if [ ! -d /build/source/.git ]; then
      git init /build/source
      git -C /build/source remote add origin /project
      git -C /build/source sparse-checkout init --cone
      git -C /build/source sparse-checkout set tools release/src release/src-rt release/src-rt-5.02hnd
    fi
    cd /build/source
    git config --global --add safe.directory /build/source
    git config --global --add safe.directory /project
    git remote set-url origin /project
    git config extensions.partialClone origin
    git config remote.origin.promisor true
    git config remote.origin.partialclonefilter blob:none
    git fetch --upload-pack="git -c uploadpack.allowFilter=true upload-pack" \
      --no-tags --depth 1 --filter=blob:none origin "$SOURCE_REVISION"
    git checkout --detach --force FETCH_HEAD
    git clean -ffdqx
    set +u
    source /home/docker/envs/bcm-hnd.sh
    set -u
    chown -R docker:docker /build/source
    gosu docker make -C release/src-rt-5.02hnd rt-ac86u
    images=(release/src-rt-5.02hnd/image/RT-AC86U_*_ubi.w)
    test -f "${images[0]}"
    cp "${images[@]}" /artifacts/
    git rev-parse HEAD > /artifacts/source-commit.txt
    cd /artifacts
    sha256sum RT-AC86U_*_ubi.w > SHA256SUMS
    chown "$OUTPUT_UID:$OUTPUT_GID" RT-AC86U_*_ubi.w source-commit.txt SHA256SUMS
  '
